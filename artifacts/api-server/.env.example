# Inspector-request email notifications (comma-separated; set empty to disable)
INSPECTOR_REQUEST_NOTIFY_EMAILS=msutherland@marvolenterprises.com
PUBLIC_APP_URL=https://airport-janitorial-manager.replit.app

# Optional dedicated HMAC key for short-lived upload capabilities (32+ chars).
# When omitted, the API derives a purpose-separated key from CLERK_SECRET_KEY.
UPLOAD_TOKEN_SECRET=

# Microsoft Graph application credentials and sending mailbox
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX=inspector@marvolenterprises.com

# Two-way supervisor/inspector conversation email through SendGrid.
# Keep the two secrets distinct and use random values of at least 32 characters.
SENDGRID_EMAIL_BRIDGE_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=messages@marvolenterprises.com
SENDGRID_INBOUND_DOMAIN=replies.marvolenterprises.com
SENDGRID_REPLY_TOKEN_SECRET=
SENDGRID_INBOUND_WEBHOOK_SECRET=
SENDGRID_REPLY_TOKEN_TTL_DAYS=30
MESSAGE_EMAIL_OUTBOX_POLL_MS=1000
MESSAGE_EMAIL_OUTBOX_LEASE_MS=60000
MESSAGE_EMAIL_OUTBOX_BATCH_SIZE=10
MESSAGE_EMAIL_OUTBOX_MAX_ATTEMPTS=8

# Durable 15-minute inspector-task escalation. An external scheduler should
# POST /api/tasks/internal/inspector-escalations/sweep every minute using this
# independent 32+ character bearer secret when the app uses autoscale.
INTERNAL_CRON_SECRET=
INSPECTOR_ESCALATION_POLL_MS=30000
