# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://airport:airport@db:5432/airport_manager
DB_SSL=false

# Change all three before production.
ADMIN_PASSWORD=local-development-password
SESSION_SECRET=local-development-session-secret-change-me
CRON_SECRET=local-development-cron-secret-change-me

# Operations
OPERATIONS_TIMEZONE=America/New_York
INTERNAL_RESPONSE_MINUTES=15
WEEKDAY_SUPERVISOR_NAME=Priscilla
WEEKDAY_SUPERVISOR_EMAIL=priscilla@example.com
WEEKEND_SUPERVISOR_NAME=Ronaldo
WEEKEND_SUPERVISOR_EMAIL=ronaldo@example.com
ESCALATION_EMAILS=operations-manager@example.com
ATTACHMENT_MAX_BYTES=10485760

# Microsoft 365 / Microsoft Graph
# Create a dedicated mailbox such as inspectors@marvolenterprises.com.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX=inspectors@marvolenterprises.com
GRAPH_WEBHOOK_CLIENT_STATE=replace-with-a-long-random-value

# Translation: auto, openai, azure, or none.
TRANSLATION_PROVIDER=auto

# OpenAI translation option
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini

# Azure AI Translator option
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
